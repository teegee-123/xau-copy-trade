# ===========================================
# PAPER TRADING DASHBOARD - ENVIRONMENT CONFIG
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------
# Server Configuration
# -------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------
# Telegram Configuration (MTProto)
# -------------------------------------------
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890
TELEGRAM_CHANNEL_ID=-1001234567890

# -------------------------------------------
# Trade Configuration
# -------------------------------------------
DEFAULT_LOT_SIZE=0.1
DEFAULT_SYMBOL=XAUUSD

# -------------------------------------------
# Price API Configuration (FREE TIERS)
# -------------------------------------------
# The application works WITHOUT an API key using simulated prices.
# For real market data, choose ONE of these FREE options:

# Option 1: Twelve Data (RECOMMENDED - 800 calls/day free)
# Get API key from: https://twelvedata.com/
PRICE_API_KEY=your_twelvedata_api_key

# Option 2: GoldAPI.io (500 calls/month free)
# Get API key from: https://www.goldapi.io/
# PRICE_API_KEY=your_goldapi_key

# Option 3: Metals-API (free tier available)
# Get API key from: https://metals-api.com/
# PRICE_API_KEY=your_metalsapi_key

# If no API key is provided, the app will use realistic simulated
# prices that fluctuate around the current XAU/USD rate (~$2650/oz)

# -------------------------------------------
# Session Storage
# -------------------------------------------
SESSION_FILE_PATH=./data/session.json

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_LINES=1000

# -------------------------------------------
# Database
# -------------------------------------------
DATABASE_PATH=./data/trades.db

# -------------------------------------------
# Trading Controls
# -------------------------------------------
TRADING_ENABLED=true
SL_TP_TIMEOUT_MINUTES=5
