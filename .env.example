# ===========================================
# PAPER TRADING DASHBOARD - ENVIRONMENT CONFIG
# ===========================================
# Copy this file to .env and fill in your values

# -------------------------------------------
# Server Configuration
# -------------------------------------------
PORT=3000
NODE_ENV=development

# -------------------------------------------
# Render.com Deployment (Free Tier)
# -------------------------------------------
# For deployment on Render.com free tier (512MB RAM, 0.25 vCPU)
# Set these when deploying to Render:
# NODE_OPTIONS=--max-old-space-size=400
# SESSION_FILE_PATH=/tmp/session.json
# DATABASE_PATH=/tmp/trades.db
# LOG_FILE_PATH=/tmp/app.log
# See render.yaml and docs/render-deployment.md for details

# -------------------------------------------
# Telegram Configuration (MTProto)
# -------------------------------------------
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_PHONE=+1234567890
TELEGRAM_CHANNEL_ID=-1001234567890

# -------------------------------------------
# Trade Configuration
# -------------------------------------------
DEFAULT_LOT_SIZE=0.1
DEFAULT_SYMBOL=XAUUSD

# -------------------------------------------
# Price Feed Configuration
# -------------------------------------------
# Swissquote Public API (no API key required)
# The application fetches XAU/USD prices from:
# https://forex-data-feed.swissquote.com/public-quotes/bboquotes/instrument/XAU/USD

# Polling interval in milliseconds (default: 1000ms)
# Must be between 200ms and 120000ms (120 seconds)
PRICE_FEED_POLLING_INTERVAL_MS=1000

# -------------------------------------------
# Session Storage
# -------------------------------------------
SESSION_FILE_PATH=./data/session.json

# -------------------------------------------
# Logging Configuration
# -------------------------------------------
LOG_LEVEL=info
LOG_FILE_PATH=./logs/app.log
LOG_MAX_LINES=1000

# -------------------------------------------
# Database
# -------------------------------------------
DATABASE_PATH=./data/trades.db

# -------------------------------------------
# Trading Controls
# -------------------------------------------
TRADING_ENABLED=true
SL_TP_TIMEOUT_MINUTES=5
