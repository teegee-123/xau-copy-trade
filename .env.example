# Application Settings
APP_NAME=XAU Copy Trade
DEBUG=false
HOST=0.0.0.0
PORT=8000

# ============================================
# Telegram Configuration (Required)
# Get these from https://my.telegram.org/apps
# ============================================

# Your Telegram API ID (integer)
TELEGRAM_API_ID=

# Your Telegram API Hash (string)
TELEGRAM_API_HASH=

# Phone number for the Telegram account (with country code)
TELEGRAM_PHONE=

# Channel ID to monitor (use negative number for supergroups/channels)
# To get channel ID: forward a message from the channel to @userinfobot
TELEGRAM_CHANNEL_ID=

# Session name for Telethon (default is fine)
TELEGRAM_SESSION_NAME=xau_copy_trade

# ============================================
# Signal Parsing Regex Patterns
# Customize these based on your signal channel format
# ============================================

# Symbol pattern (matches XAUUSD, XAU/USD, GOLD, etc.)
SIGNAL_SYMBOL_PATTERN=(?i)(XAUUSD|XAU/USD|GOLD|GOLDUSD)\b

# Direction pattern (matches BUY, SELL, LONG, SHORT)
SIGNAL_DIRECTION_PATTERN=(?i)\b(BUY|SELL|LONG|SHORT)\b

# Entry price pattern (matches "Entry: 4556" or "@ 4556")
SIGNAL_ENTRY_PATTERN=(?i)(?:entry|enter|@|around)\s*[:\-]?\s*(\d{4,}(?:\.\d+)?)

# Entry range pattern (matches "Entry 4553-4556")
SIGNAL_ENTRY_RANGE_PATTERN=(?i)(?:entry|enter)\s*[:\-]?\s*(\d{4,}(?:\.\d+)?)\s*[-–]\s*(\d{4,}(?:\.\d+)?)

# Stop Loss pattern (matches "SL: 4546" or "Stop Loss 4546")
SIGNAL_SL_PATTERN=(?i)(?:SL|Stop Loss|StopLoss|S\.L\.?)\s*[:\-]?\s*(\d{4,}(?:\.\d+)?)

# Take Profit single pattern (matches "TP: 4559")
SIGNAL_TP_PATTERN=(?i)(?:TP|Take Profit|TakeProfit|T\.P\.?)\s*[:\-]?\s*(\d{4,}(?:\.\d+)?)

# Take Profit multiple pattern (matches "TP: 4559, 4569, 4579")
SIGNAL_TP_MULTI_PATTERN=(?i)(?:TPs?|Take\s*Profits?)\s*[:\-]?\s*([\d.,\s]+)

# ============================================
# Trading Defaults
# ============================================

# Default position size in lots
DEFAULT_POSITION_SIZE=0.01

# Default leverage
DEFAULT_LEVERAGE=1

# Maximum time for pending trades (minutes)
MAX_PENDING_TIME_MINUTES=60

# ============================================
# Price Feed Configuration
# ============================================

# Binance Futures WebSocket URL
BINANCE_WS_URL=wss://fstream.binance.com/ws

# Symbol for XAU/USD on Binance (XAUUSDT)
BINANCE_SYMBOL=XAUUSDT

# ============================================
# Security
# ============================================

# Session secret key (change in production!)
SESSION_SECRET=change-me-in-production

# ============================================
# Deployment
# ============================================

# Set to true when running on Render
RENDER_DEPLOYED=false
