{
  "name": "xau-copy-trade",
  "version": "1.0.0",
  "description": "Paper trading dashboard for XAU/USD signals from Telegram",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "cd src/client && npm run dev",
    "install:client": "cd src/client && npm install",
    "build": "npm run install:client && npm run build:client && npm run build:server",
    "build:client": "cd src/client && npm run build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "npm run build && node dist/server/index.js",
    "start:dist": "node dist/server/index.js",
    "start:render": "node dist/server/index.js",
    "render:build": "cd src/client && npm install && npm run build && cd ../.. && npm run build:server",
    "healthcheck": "node render-healthcheck.js",
    "lint": "eslint src --ext .ts,.tsx",
    "postinstall": "node -e \"try { require('child_process').execSync('node-gyp rebuild', { cwd: 'node_modules/better-sqlite3', stdio: 'ignore' }); console.log('better-sqlite3 rebuilt'); } catch (e) { console.log('Skipping better-sqlite3 rebuild (expected on Render)'); }\" || exit 0"
  },
  "dependencies": {
    "axios": "^1.6.7",
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "grammy": "^1.19.0",
    "telegram": "^2.22.1",
    "teleproto": "^1.223.2",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^3.10.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.9",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.19",
    "@types/react": "^18.2.55",
    "@types/react-dom": "^18.2.19",
    "@types/recharts": "^1.8.29",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.1",
    "@typescript-eslint/parser": "^7.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  }
}
